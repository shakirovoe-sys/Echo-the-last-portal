        if (!drewSpikeTexture) {
          ctx.fillStyle = "rgba(255, 255, 255, 0.35)";
          for (let offset = 0; offset < platform.w; offset += 24) {
            ctx.beginPath();
            ctx.moveTo(x + offset, y);
