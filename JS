  ctx.fill();
  ctx.restore();
}
function drawPlayer() {
  const x = player.x - camera.x;
  const y = player.y - camera.y;
  ctx.save();
  ctx.shadowColor = player.color;
  ctx.shadowBlur = 14;
  if (textures.player.ready) {
    roundedRectanglePath(x, y, player.w, player.h, 8);
    ctx.clip();
    drawImageCover(textures.player.image, x, y, player.w, player.h);
  } else {
    ctx.fillStyle = player.color;
    roundedRectanglePath(x, y, player.w, player.h, 8);
    ctx.fill();
    ctx.shadowBlur = 0;
    ctx.fillStyle = "#07222a";
    ctx.fillRect(x + 7, y + 10, 5, 5);
    ctx.fillRect(x + 17, y + 10, 5, 5);
    ctx.fillStyle = "rgba(255, 255, 255, 0.7)";
    ctx.fillRect(x + 5, y + player.h - 8, player.w - 10, 3);
  }
  ctx.restore();
}
function drawExit() {
  const x = exitDoor.x - camera.x;
  const y = exitDoor.y - camera.y;
  ctx.save();
  ctx.fillStyle = "#172738";
  ctx.fillRect(x, y, exitDoor.w, exitDoor.h);
  ctx.shadowColor = "#65f4d1";
  ctx.shadowBlur = 15;
  ctx.strokeStyle = "#65f4d1";
  ctx.lineWidth = 4;
  ctx.strokeRect(x, y, exitDoor.w, exitDoor.h);
  ctx.shadowBlur = 0;
  ctx.fillStyle = "#65f4d1";
  ctx.fillRect(x + 20, y + 38, 14, 14);
  ctx.restore();
}
function drawHint(hint) {
  const x = hint.x - camera.x;
  const y = hint.y - camera.y;
  if (x < -250 || x > canvas.width + 250) return;
  ctx.save();
  ctx.font = "14px system-ui";
  ctx.textAlign = "center";
  ctx.fillStyle = "rgba(238, 247, 255, 0.8)";
  ctx.fillText(hint.text, x, y);
  ctx.restore();
}
function render() {
  drawBackground();
  drawPlatforms();
  drawPortal(portals.blue, "#27a8ff");
