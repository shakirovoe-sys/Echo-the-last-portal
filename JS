    ctx.fillRect(x, y, platform.w, platform.h);
    const drewPlatformTexture = isPortalSurface
      ? drawRepeatingTexture(
          platformTexture,
          x,
          y,
          platform.w,
          platform.h,
          GAME_CONFIG.portalTextureTileSize
        )
      ? false
      : drawRepeatingTexture(
          platformTexture,
          textures.normalPlatform,
          x,
          y,
          platform.w,
          Math.min(platform.h, GAME_CONFIG.platformTextureDepth),
          GAME_CONFIG.platformTextureDepth,
          GAME_CONFIG.normalPlatformTextureCrop
