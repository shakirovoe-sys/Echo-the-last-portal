  ctx.shadowColor = color;
  ctx.shadowBlur = 24;
  ctx.fillStyle = color;
  roundedRectanglePath(x, y, portal.w, portal.h, 10);
  ctx.fill();
  ctx.shadowBlur = 0;
  ctx.fillStyle = "rgba(2, 8, 14, 0.86)";
  roundedRectanglePath(
    x + Math.min(4, portal.w / 4),
    y + Math.min(4, portal.h / 4),
    Math.max(4, portal.w - 8),
    Math.max(4, portal.h - 8),
    8
