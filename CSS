:root {
  --bg: #07111f;
  --panel: rgba(8, 20, 36, 0.94);
  --text: #eef7ff;
  --muted: #9bb1c8;
  --blue: #27a8ff;
  --orange: #ff8a24;
  --danger: #ff4e67;
  --platform: #dbe8f5;
  --portal-wall: #f7fbff;
  --accent: #65f4d1;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  display: grid;
  place-items: center;
  background:
    radial-gradient(circle at top, #15345a 0%, transparent 40%),
    linear-gradient(180deg, #07111f 0%, #02060c 100%);
  color: var(--text);
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.game-shell {
  width: min(820px, 94vw);
  padding: 12px;
}

.topbar {
  display: flex;
  gap: 16px;
  justify-content: space-between;
  align-items: end;
  margin-bottom: 10px;
  flex-wrap: wrap;
}

.title {
  margin: 0;
  font-size: clamp(18px, 3vw, 26px);
  font-weight: 800;
  letter-spacing: 0.02em;
}

.subtitle {
  margin: 3px 0 0;
  color: var(--muted);
  font-size: 12px;
}

.controls,
.hud,
.menu-actions,
.modal-actions {
  display: flex;
  gap: 8px;
  align-items: center;
  flex-wrap: wrap;
}

.hud {
  margin-bottom: 10px;
}

.difficulty-control,
.chip {
  padding: 8px 11px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.06);
  color: var(--muted);
  font-size: 13px;
  backdrop-filter: blur(8px);
}

.difficulty-control {
  display: flex;
  gap: 8px;
  align-items: center;
}

.chip {
  border-radius: 999px;
}

.chip strong {
  color: var(--text);
}

select {
  border: 0;
  border-radius: 8px;
  padding: 7px 9px;
  color: var(--text);
  background: #102840;
  font: inherit;
  font-weight: 700;
  cursor: pointer;
}

.canvas-wrap {
  position: relative;
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 18px;
  overflow: hidden;
  background: #081421;
  box-shadow: 0 18px 50px rgba(0, 0, 0, 0.35);
}

canvas {
  width: 100%;
  height: auto;
  display: block;
  background: linear-gradient(#0e243b, #07111d);
  cursor: crosshair;
  touch-action: none;
}

.menu-screen,
.overlay {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  padding: 10px;
  background:
    radial-gradient(circle at 50% 30%, rgba(39, 168, 255, 0.17), transparent 43%),
    rgba(1, 6, 12, 0.76);
  backdrop-filter: blur(8px);
}

.menu-screen {
  z-index: 4;
  opacity: 1;
  pointer-events: auto;
  transition: opacity 0.2s ease;
}

.menu-screen.hidden {
  opacity: 0;
  pointer-events: none;
}

.menu-screen[hidden] {
  display: none !important;
}

.menu-card,
.modal {
  width: min(520px, 100%);
  padding: clamp(16px, 2.5vw, 22px);
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 22px;
  background:
    linear-gradient(145deg, rgba(16, 42, 69, 0.97), rgba(5, 16, 29, 0.97));
  box-shadow: 0 25px 70px rgba(0, 0, 0, 0.45);
  text-align: center;
}

.eyebrow {
  margin: 0 0 8px;
  color: var(--accent);
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.18em;
}

.menu-card h2,
.modal h2 {
  margin: 0 0 10px;
  font-size: clamp(24px, 4vw, 32px);
}

.menu-copy,
.modal p {
  margin: 0 0 14px;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.4;
}

.menu-difficulty {
  display: grid;
  gap: 8px;
  margin: 0 auto 12px;
  color: var(--text);
  font-size: 13px;
  font-weight: 800;
  text-align: left;
}

.menu-difficulty select {
  width: 100%;
  padding: 9px 11px;
}

.menu-actions,
.modal-actions {
  justify-content: center;
}

.menu-controls {
  margin: 10px 0 0;
  color: var(--muted);
  font-size: 11px;
}

.overlay {
  z-index: 3;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease;
}

.overlay.show {
  opacity: 1;
  pointer-events: auto;
}

.modal {
  background: var(--panel);
}

button {
  border: 0;
  border-radius: 12px;
  padding: 11px 18px;
  color: #00101b;
  background: var(--accent);
  font: inherit;
  font-weight: 800;
  cursor: pointer;
  transition: transform 0.15s ease, filter 0.15s ease;
}

.start-button {
  min-width: 190px;
  padding: 13px 24px;
  font-size: 16px;
}

.secondary-button {
  border: 1px solid rgba(255, 255, 255, 0.16);
  color: var(--text);
  background: rgba(255, 255, 255, 0.08);
}

button:hover {
  filter: brightness(1.08);
  transform: translateY(-1px);
}

button:active {
  transform: translateY(0);
}

.game-error {
  position: absolute;
  z-index: 8;
  right: 14px;
  bottom: 14px;
  left: 14px;
  padding: 12px 14px;
  border: 1px solid rgba(255, 78, 103, 0.6);
  border-radius: 10px;
  color: #fff;
  background: rgba(96, 12, 28, 0.94);
  font-size: 13px;
  text-align: center;
}

.help {
  margin-top: 10px;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.55;
}

.help strong {
  color: var(--text);
}

@media (max-width: 760px) {
  body {
    place-items: start center;
  }

  .game-shell {
    padding: 8px;
  }

  .topbar,
  .controls {
    align-items: stretch;
  }

  .topbar > div:first-child,
  .controls {
    width: 100%;
  }

  .difficulty-control {
    flex: 1;
    justify-content: space-between;
  }

  .menu-screen,
  .overlay {
    padding: 12px;
  }

  .menu-card {
    padding: 20px;
  }

  .help {
    font-size: 12px;
  }
}
